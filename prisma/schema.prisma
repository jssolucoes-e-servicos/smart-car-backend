generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
  moduleFormat    = "cjs"
}

generator seedClient {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  OTHER
}

enum InvoiceStatusEnum {
  PENDING
  PAID
  CANCELED
  OVERDUE
  REFUNDED
}

enum PaymentFrequencyEnum {
  MONTHLY
  BIANNUAL
  ANNUAL
}

enum PlanPaymentMethodEnum {
  PIX
  CREDIT_CARD
  INVOICE
}

enum BudgetStatusEnum {
  PENDENT
  APPROVED
  REJECTED
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELED
}

enum PaymentMethodEnum {
  PIX_OFFLINE
  PIX_ONLINE
  CARD_DEBIT
  CARD_CREDIT
  CARD_LINK
  MONEY
  OTHER
}

enum ReceiptEnum {
  IN
  OUT
}

model Manager {
  id       String @id @default(cuid())
  name     String @unique
  cpf      String
  phone    String
  email    String @unique
  password String

  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("managers")
}

model Plan {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  month           Float            @default(0)
  biannual        Float            @default(0)
  annual          Float            @default(0)
  maxUsers        Int              @default(0)
  maxBudgetsMonth Int              @default(0)
  maxDevices      Int              @default(0)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  planCompanies   PlanCompany[]
  companyInvoices CompanyInvoice[]

  @@map("plans")
}

model Company {
  id            String @id @default(cuid())
  name          String
  fantasy       String
  cnpj          String
  ie            String
  phone         String
  email         String
  addressInLine String
  zipCode       String
  publicPlace   String
  number        String
  complement    String
  neighborhood  String
  city          String
  state         String
  logo          String
  hash          String @default(uuid())

  active                Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  companySettings       CompanySetting[]
  users                 User[]
  planCompanies         PlanCompany[]
  companyInvoices       CompanyInvoice[]
  services              Service[]
  budgets               Budget[]
  budgetStatusHistories BudgetStatusHistory[]
  counters              Counter[]
  budgetItems           BudgetItem[]
  budgetPayments        BudgetPayment[]
  receipts              Receipt[]

  @@map("companies")
}

model CompanySetting {
  id               String  @id @default(cuid())
  company          Company @relation(fields: [companyId], references: [id])
  companyId        String
  themeColor       String  @default("#000000")
  mercadoPagoKey   String?
  mercadoPagoToken String?
  mercadoPagoMode  String  @default("TEST")
  mercadoPagoEmail String?
  pixKey           String?

  usingEMAIL    Boolean @default(false) // true, false
  emailHost     String?
  emailUser     String?
  emailPassword String?
  emailPort     Int?

  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("company_settings")
}

model User {
  id                    String                @id @default(cuid())
  company               Company               @relation(fields: [companyId], references: [id])
  companyId             String
  code                  Int
  name                  String
  email                 String                @unique
  password              String
  active                Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  budgetStatusHistories BudgetStatusHistory[]
  budgetPayments        BudgetPayment[]
  receipts              Receipt[]

  @@map("users")
}

model PlanCompany {
  id               String                @id @default(cuid())
  company          Company               @relation(fields: [companyId], references: [id])
  companyId        String
  plan             Plan                  @relation(fields: [planId], references: [id])
  planId           String
  isTrial          Boolean               @default(false)
  expiresAt        DateTime?
  expired          Boolean               @default(false)
  paymentFrequency PaymentFrequencyEnum  @default(MONTHLY)
  dueDate          Int                   @default(15)
  paymentMethod    PlanPaymentMethodEnum @default(PIX)

  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("plan_companies")
}

model CompanyInvoice {
  id            String                @id @default(cuid())
  company       Company               @relation(fields: [companyId], references: [id])
  companyId     String
  plan          Plan                  @relation(fields: [planId], references: [id])
  planId        String
  reference     String
  amount        Float                 @default(0)
  dueDate       DateTime
  paid          Boolean               @default(false)
  paidAt        DateTime?
  externalId    String?
  externalMeta  String?
  providerName  String?
  paymentMethod PlanPaymentMethodEnum @default(PIX)
  invoiceStatus InvoiceStatusEnum     @default(PENDING)

  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("company_invoices")
}

model Service {
  id          String  @id @default(cuid())
  company     Company @relation(fields: [companyId], references: [id])
  companyId   String
  code        Int
  name        String
  description String  @default("")
  value       Float

  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  budgetItems BudgetItem[]

  @@map("services")
}

model Counter {
  id        String    @id @default(uuid())
  company   Company   @relation(fields: [companyId], references: [id])
  companyId String
  budget    Int       @default(0)
  service   Int       @default(0)
  receipt   Int       @default(0)
  user      Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("budget_counters")
}

model Budget {
  id           String           @id @default(uuid())
  company      Company          @relation(fields: [companyId], references: [id])
  companyId    String
  code         Int
  customerName String
  document     String           @default("")
  phone        String           @default("")
  email        String           @default("")
  zipCode      String           @default("")
  publicPlace  String           @default("")
  number       String           @default("")
  complement   String           @default("")
  neighborhood String           @default("")
  city         String           @default("")
  brand        String
  model        String
  plate        String
  year         String           @default("")
  km           String           @default("")
  description  String           @default("")
  totalValue   Float
  status       BudgetStatusEnum @default(PENDENT)
  approved     Boolean          @default(false)

  active                Boolean               @default(true)
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  budgetStatusHistories BudgetStatusHistory[]
  budgetItems           BudgetItem[]
  budgetPayments        BudgetPayment[]
  receipts              Receipt[]

  @@map("budgets")
}

model BudgetStatusHistory {
  id        String           @id @default(cuid())
  company   Company          @relation(fields: [companyId], references: [id])
  companyId String
  budget    Budget           @relation(fields: [budgetId], references: [id])
  budgetId  String
  statusOld BudgetStatusEnum @default(PENDENT)
  status    BudgetStatusEnum @default(PENDENT)
  user      User             @relation(fields: [userId], references: [id])
  userId    String

  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("budget_status_histories")
}

model BudgetItem {
  id           String   @id @default(uuid())
  company      Company  @relation(fields: [companyId], references: [id])
  companyId    String
  budget       Budget   @relation(fields: [budgetId], references: [id])
  budgetId     String
  serviceName  String
  serviceValue Float
  suggestValue Float    @default(0)
  referenceId  String?
  reference    Service? @relation(fields: [referenceId], references: [id])
  name         String
  value        Float
  removed      Boolean  @default(false)

  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("budget_items")
}

model BudgetPayment {
  id           String            @id @default(cuid())
  company      Company           @relation(fields: [companyId], references: [id])
  companyId    String
  budget       Budget            @relation(fields: [budgetId], references: [id])
  budgetId     String
  amount       Float
  method       PaymentMethodEnum @default(OTHER)
  externalId   String?
  externalMeta String?
  forCustomer  Boolean           @default(false)
  user         User?             @relation(fields: [userId], references: [id])
  userId       String?
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
}

// Modelo de Recibos emitidos
model Receipt {
  id            String            @id @default(cuid())
  company       Company           @relation(fields: [companyId], references: [id])
  companyId     String
  code          Int
  budget        Budget?           @relation(fields: [budgetId], references: [id])
  budgetId      String?
  recipientName String
  document      String
  receiptType   ReceiptEnum       @default(IN) // Tipos: IN, OUT
  valueExtense  String
  description   String
  reverse       Boolean           @default(false)
  paymentMethod PaymentMethodEnum @default(OTHER) // Métodos: PIX_OFFLINE, PIX_ONLINE, CARD_DEBIT, CARD_CREDIT, CARD_LINK, MONEY, OTHER
  value         Float             @default(0) // Valor do recibo
  user          User              @relation(fields: [userId], references: [id])
  userId        String
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime          @default(now())

  @@map("receipts")
}
